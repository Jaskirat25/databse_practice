<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>
    <div class="bg-zinc-900 p-10 text-white w-full min-h-screen">
        <h1 class="tracking-tighter text-3xl mb-3">All Users</h1>
        <div class="users flex flex-wrap gap-4">
            <div class="user bg-zinc-600 p-4 max-w-xs rounded-lg flex-1">
                <div class="bg-zinc-300 w-full h-32 rounded-lg"></div>
                <h3 class="text-xl mt-3 tracking-tighter">Jaskirat Singh</h3>
                <h5 class="text-zinc-200">jaskirat@gmail.com</h5>
                <div class="flex gap-3 mt-10">
                    <a class="text-zinc-200" href="#">Edit User</a>
                    <a class="text-red-500" href="#">Delete</a>
                </div>
            </div>

            <div class="user bg-zinc-600 p-4 max-w-xs rounded-lg flex-1">
                <div class="bg-zinc-300 w-full h-32 rounded-lg"></div>
                <h3 class="text-xl mt-3 tracking-tighter">Jaskirat Singh</h3>
                <h5 class="text-zinc-200">jaskirat@gmail.com</h5>
                <div class="flex gap-3 mt-10">
                    <a class="text-zinc-200" href="#">Edit User</a>
                    <a class="text-red-500" href="#">Delete</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
