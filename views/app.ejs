<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-black text-white">
    <div class="flex flex-col items-center justify-center h-screen">
        <h1 class="text-3xl font-bold mb-4">All Users</h1>
        <form class="flex space-x-4" action="create" method="post">
            <input type="text" placeholder="Name" class="bg-gray-800 text-white px-4 py-2 rounded" name="name">
            <input type="email" placeholder="Email" class="bg-gray-800 text-white px-4 py-2 rounded" name="email">
            <input type="text" placeholder="Image URL" class="bg-gray-800 text-white px-4 py-2 rounded" name="image">
            <button type="submit" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">Submit</button>
        </form>
    </div>
</body>
</html>